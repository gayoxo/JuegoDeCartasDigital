FROM node:22-bookworm

RUN apt-get update \
 && apt-get install --yes --no-install-recommends \
      xvfb xauth libasound2 libatk-bridge2.0-0 libatk1.0-0 libcups2 libdbus-1-3 \
      libdrm2 libgbm1 libgtk-3-0 libnspr4 libnss3 libx11-xcb1 libxcomposite1 \
      libxdamage1 libxfixes3 libxkbcommon0 libxrandr2 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app/desktop
COPY --chown=node:node desktop/package.json desktop/package-lock.json ./
RUN npm ci && npx install-electron --no
RUN chown root:root node_modules/electron/dist/chrome-sandbox \
 && chmod 4755 node_modules/electron/dist/chrome-sandbox
COPY --chown=node:node desktop/main.cjs ./main.cjs
COPY --chown=node:node desktop/lib ./lib
COPY --chown=node:node desktop/test ./test
COPY --chown=node:node dist /app/dist

USER node
CMD ["sh", "-lc", "Xvfb :99 -screen 0 1280x1024x24 -nolisten tcp >/tmp/xvfb.log 2>&1 & export DISPLAY=:99; sleep 1; timeout 45 npm run test:smoke"]
